rules_version = '2';

// Default deny. Browsers reach exactly one collection: camera signaling (monitorSessions).
//
// Principles:
//  - Every other read and write goes through trusted server code (Admin SDK), which bypasses
//    these rules and checks the session, the role, and the teacher space on every call.
//    Closing the rest to clients means a signed-in teacher cannot use the Firebase SDK to read
//    another teacher's subjects, questions, exams, students, or results.
//  - Camera sessions belong to one teacher space. Only that space's teacher can watch, and only
//    the student who owns the attempt can publish.
//  - Authorization uses the role custom claim AND the users/{uid} profile
//    (active, role matches). A profile field alone never grants access.
//  - Nothing is granted to unauthenticated requests. Deletes are denied everywhere.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Token claim, profile existence, profile active flag, and profile role must all agree.
    function isActiveRole(role) {
      return signedIn()
        && request.auth.token.get('role', '') == role
        && exists(profilePath())
        && get(profilePath()).data.isActive == true
        && get(profilePath()).data.role == role;
    }

    function isAdmin() {
      return isActiveRole('ADMIN');
    }

    function isStudent() {
      return isActiveRole('STUDENT');
    }

    // The caller's teacher space, from the server-written profile.
    function myWorkspace() {
      return get(profilePath()).data.workspaceId;
    }

    // ---------- camera monitoring signaling (no media is stored) ----------
    // The student publishes an SDP offer and ICE candidates for their own attempt.
    // The teacher of the same space answers. Neither side can change the other's fields.
    // Each viewer writes request.viewerId; the student answers with a fresh offer whose
    // offerFor names that viewer. Leaving and returning to the monitor page reconnects this way.

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/monitorSessions/$(sessionId)).data;
    }

    function ownsMonitorSession(sessionId) {
      return isStudent() && sessionData(sessionId).studentId == request.auth.uid;
    }

    function watchesMonitorSession(sessionId) {
      return isAdmin() && sessionData(sessionId).workspaceId == myWorkspace();
    }

    match /monitorSessions/{attemptId} {
      allow read: if (isAdmin() && resource.data.workspaceId == myWorkspace())
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.workspaceId == myWorkspace()
        && request.resource.data.keys().hasOnly(['studentId', 'workspaceId', 'offer', 'offerFor', 'answer', 'status', 'updatedAt'])
        && request.resource.data.answer == null
        && request.resource.data.status == 'live';

      allow update: if (isStudent() && resource.data.studentId == request.auth.uid
            && request.resource.data.workspaceId == myWorkspace()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workspaceId', 'offer', 'offerFor', 'answer', 'status', 'updatedAt'])
            && request.resource.data.answer == null)
        // Leaving the exam page marks the session ended, even after the teacher answered.
        || (isStudent() && resource.data.studentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'ended')
        || (isAdmin()
            && resource.data.workspaceId == myWorkspace()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'request', 'updatedAt'])
            && resource.data.offer != null);

      allow delete: if false;

      match /studentCandidates/{candidateId} {
        allow read: if watchesMonitorSession(attemptId) || ownsMonitorSession(attemptId);
        allow create: if ownsMonitorSession(attemptId);
        allow update, delete: if false;
      }

      match /adminCandidates/{candidateId} {
        allow read: if watchesMonitorSession(attemptId) || ownsMonitorSession(attemptId);
        allow create: if watchesMonitorSession(attemptId);
        allow update, delete: if false;
      }
    }

    // ---------- everything else: server only ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
